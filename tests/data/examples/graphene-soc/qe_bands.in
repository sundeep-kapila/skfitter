&CONTROL
  calculation = 'bands'
  prefix = 'graphene_soc'
  outdir = './tmp'
  pseudo_dir = '/home/sundeep/qe_2d/pseudo'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 4
  a = 2.467
  c = 20.0
  nat = 2
  ntyp = 1
  noncolin = .true.
  lspinorb = .true.
  ecutwfc = 50
  ecutrho = 400
  nbnd = 24
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.005
/
&ELECTRONS
  conv_thr = 1.0d-13
  mixing_beta = 0.3
  diago_full_acc = .true.
/
ATOMIC_SPECIES
  C 12.011 C.rel-pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  C 0.333333333333 0.666666666667 0.000000000000
  C 0.666666666667 0.333333333333 0.000000000000
K_POINTS crystal_b
4
  0.000000000000 0.000000000000 0.0 40 ! G
  0.500000000000 0.000000000000 0.0 24 ! M
  0.333333333333 0.333333333333 0.0 48 ! K
  0.000000000000 0.000000000000 0.0  1 ! G
