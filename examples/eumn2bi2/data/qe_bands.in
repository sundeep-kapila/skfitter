&CONTROL
  calculation = 'bands'
  prefix = 'eumn2bi2_for_paper'
  outdir = './qe_scratch'
  pseudo_dir = './qe_pseudo'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 10
  ntyp = 5
  noncolin = .true.
  lspinorb = .true.
  starting_magnetization(1) = 0.8
  angle1(1) = 0.0
  angle2(1) = 0.0
  starting_magnetization(2) = 0.8
  angle1(2) = 180.0
  angle2(2) = 0.0
  starting_magnetization(3) = 0.6
  angle1(3) = 0.0
  angle2(3) = 0.0
  starting_magnetization(4) = 0.6
  angle1(4) = 180.0
  angle2(4) = 0.0
  ecutwfc = 85
  ecutrho = 480
  nbnd = 200
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-5
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
  mixing_ndim = 12
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Eu1 151.96 Eu.paw.z_17.atompaw.wentzcovitch.v1.2.upf
  Eu2 151.96 Eu.paw.z_17.atompaw.wentzcovitch.v1.2.upf
  Mn1 54.938 Mn.dojo04-pbe-fr.upf
  Mn2 54.938 Mn.dojo04-pbe-fr.upf
  Bi 208.98 Bi.dojo04-pbe-fr.upf
