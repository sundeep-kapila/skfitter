&CONTROL
  calculation = 'bands'
  prefix = 'pt_soc'
  outdir = './qe_scratch'
  pseudo_dir = './qe_pseudo'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  noncolin = .true.
  lspinorb = .true.
  ecutwfc = 90
  ecutrho = 360
  nbnd = 30
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
/
&ELECTRONS
  conv_thr = 1.0d-9
  mixing_beta = 0.3
/
